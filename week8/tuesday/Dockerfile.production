# ─── Stage 1: Builder ────────────────────────────────────────────────────────
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependency manifests first to preserve Docker layer caching
COPY package.json package-lock.json ./

# Install all dependencies, including TypeScript, Jest, and ESLint
RUN npm ci

# Copy application source and configuration files
COPY . .

# Compile TypeScript into JavaScript under dist/
RUN npm run build


# ─── Stage 2: Production ─────────────────────────────────────────────────────
FROM node:18-alpine AS production

WORKDIR /app

# Create a dedicated non-root service account
RUN addgroup -S kijani && adduser -S kijani -G kijani

# Copy package manifests from the builder stage
COPY --from=builder /app/package.json /app/package-lock.json ./

# Install runtime dependencies only
RUN npm ci --omit=dev

# Copy only compiled JavaScript from the builder stage
COPY --from=builder /app/dist ./dist

# Ensure the application directory belongs to the service account
RUN chown -R kijani:kijani /app

# Run the application as a non-root user
USER kijani

HEALTHCHECK --interval=30s \
  --timeout=5s \
  --start-period=15s \
  --retries=3 \
  CMD wget -qO- http://localhost:3001/health || exit 1

EXPOSE 3001

CMD ["node", "dist/index.js"]